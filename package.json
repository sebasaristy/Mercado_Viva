{
  "name": "mercado-viva",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,pwa -c blue,magenta \"npm:dev:api\" \"npm:dev:pwa\"",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:pwa": "npm run dev --workspace=apps/pwa",
    "db:migrate": "node db/migrar.js",
    "db:seed": "node db/migrar.js --semillas",
    "lint": "eslint .",
    "test": "node scripts/pruebas.js",
    "doctor": "node scripts/doctor.js",
    "dev:local": "concurrently -n api,pwa -c blue,magenta \"npm:dev:api:local\" \"npm:dev:pwa\"",
    "dev:api:local": "npm run dev:local --workspace=apps/api",
    "datos-local:reiniciar": "node -e \"require('fs').rmSync('.datos-local',{recursive:true,force:true});console.log('datos locales borrados')\"",
    "db:sql": "node scripts/sql-supabase.js"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.5"
  },
  "engines": {
    "node": ">=20"
  }
}
