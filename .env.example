# Copiar a .env y llenar. El .env no se sube al repo.
# Todo entra por la REST de Supabase: no hay conexión directa a Postgres.

# Supabase -> Settings -> API
SUPABASE_URL=https://[proyecto].supabase.co

# Clave anon. Respeta RLS. La PWA ya no la usa: el login lo hace la API.
SUPABASE_ANON_KEY=

# Clave service_role. Se salta RLS: vive SOLO en el servidor, nunca en la PWA.
# Es la que dice "service_role secret" en Settings -> API.
# NO es el "JWT secret": ese es otro valor y no sirve para esto.
SUPABASE_SERVICE_ROLE_KEY=

PORT=3000
TENANT_ID=00000000-0000-0000-0000-000000000001

# Firma los tokens de acceso (10 minutos). Obligatorio en producción; en
# desarrollo, si falta, se inventa uno al arrancar.
# Genera uno con:  openssl rand -base64 48
SESION_SECRETO=

# Solo para probar endpoints con curl sin iniciar sesión. La PWA igual pide
# login. config.js impide que quede encendido en producción.
AUTH_DESACTIVADA=false

# En un servidor abierto a internet, aunque corra en modo desarrollo:
# apaga el panel /dev y la causa de los errores 500 en las respuestas.
# HERRAMIENTAS_DEV=false

# Nada con prefijo VITE_: Vite mete esas variables en el código que descarga
# cualquiera. La PWA no necesita ninguna clave.
